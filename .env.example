# CMS origin without /api. Keep blank to use only the built content snapshot.
# Local development: http://127.0.0.1:5001
# Production must use a publicly reachable HTTPS CMS origin.
CMS_API_URL=
# Set this to the live admin HTTPS origin in Vercel (no secret or admin token).
# The full /api/public/content endpoint is also accepted.
# Legacy alias, used only when CMS_API_URL is not set.
VITE_CMS_API_URL=
